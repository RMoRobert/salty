<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App Sandbox is enabled via ENABLE_APP_SANDBOX = YES (macOS). These entitlements
	  grant the sandbox the file access the app actually needs:

	  - files.user-selected.read-write: lets the folder/file pickers (fileImporter,
	    NSOpenPanel) grant durable read/write access to a user-chosen database folder.
	  - files.bookmarks.app-scope: required to CREATE and RESOLVE security-scoped
	    bookmarks (URL.bookmarkData(options: .withSecurityScope)) so access to the
	    custom database folder survives app relaunches.

	  These keys are macOS sandbox entitlements; they are ignored (harmless) on iOS,
	  where access to user-selected URLs is granted via the document picker instead.
	-->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>

	<!--
	  Keychain Sharing, declaring this app's own default access group. Not about sharing: on macOS,
	  the data-protection keychain KeychainHelper targets is only available to a binary carrying an
	  application-identifier entitlement, which signing only issues when a capability like this one
	  requires a provisioning profile. Without it every SecItemAdd fails with errSecMissingEntitlement
	  and the app falls back to the login keychain, whose per-binary ACLs prompt on every rebuild.

	  The group resolves per configuration (…salty-dev in Debug, …salty in Release), so Debug and
	  Release keep separate credentials -- deliberate; a hard-coded group would merge them again.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>
	</array>
</dict>
</plist>
